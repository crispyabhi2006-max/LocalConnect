{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Account profile for a Customer or Business Owner (only two roles exist).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": ["customer", "owner"]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 200
        },
        "phone": {
          "type": "string",
          "maxLength": 40
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "avatarUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "emailNotifications": {
          "type": "boolean"
        },
        "pushNotifications": {
          "type": "boolean"
        },
        "fcmToken": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "role", "name", "email", "emailNotifications", "pushNotifications", "createdAt", "updatedAt"]
    },
    "Business": {
      "title": "Business",
      "description": "Public directory listing and profile owned by a Business Owner account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "nameLower": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "enum": [
            "Restaurants",
            "Hospitals and Clinics",
            "Beauty Salons",
            "Shopping Stores",
            "Educational Institutions",
            "Automobile Services",
            "Home Services",
            "Fitness Centres",
            "Other Local Businesses"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 250
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "placeId": {
          "type": "string",
          "maxLength": 200
        },
        "businessPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "publicEmail": {
          "type": "string",
          "maxLength": 200
        },
        "logoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "coverUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "galleryUrls": {
          "type": "array"
        },
        "openingHours": {
          "type": "object"
        },
        "slotDurationMinutes": {
          "type": "number"
        },
        "cancellationPolicyHours": {
          "type": "number"
        },
        "priceRange": {
          "type": "string",
          "enum": ["$", "$$", "$$$", "$$$$"]
        },
        "ratingAvg": {
          "type": "number"
        },
        "reviewCount": {
          "type": "number"
        },
        "viewCount": {
          "type": "number"
        },
        "isFeatured": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "ownerId",
        "ownerName",
        "name",
        "nameLower",
        "category",
        "description",
        "address",
        "city",
        "postalCode",
        "lat",
        "lng",
        "businessPhone",
        "openingHours",
        "slotDurationMinutes",
        "cancellationPolicyHours",
        "priceRange",
        "ratingAvg",
        "reviewCount",
        "viewCount",
        "isFeatured",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "BookedSlot": {
      "title": "BookedSlot",
      "description": "Atomic slot reservation lock preventing double-booking of a business time slot without exposing customer PII.",
      "type": "object",
      "properties": {
        "slotKey": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "appointmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["slotKey", "businessId", "ownerId", "customerId", "appointmentId", "date", "timeSlot", "createdAt"]
    },
    "Service": {
      "title": "Service",
      "description": "Bookable service offering and price belonging to a Business.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "price": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "number"
        },
        "category": {
          "type": "string",
          "maxLength": 80
        },
        "isActive": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "businessId", "ownerId", "name", "price", "durationMinutes", "isActive", "createdAt", "updatedAt"]
    },
    "Appointment": {
      "title": "Appointment",
      "description": "Customer appointment booking for a business service and time slot.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "customerEmail": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "customerPhone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 30
        },
        "serviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "servicePrice": {
          "type": "number"
        },
        "durationMinutes": {
          "type": "number"
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "timeSlot": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$"
        },
        "slotKey": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        },
        "status": {
          "type": "string",
          "enum": ["Pending", "Confirmed", "Rejected", "Cancelled", "Completed"]
        },
        "cancellationReason": {
          "type": "string",
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "businessId",
        "businessName",
        "ownerId",
        "customerId",
        "customerName",
        "customerEmail",
        "customerPhone",
        "serviceId",
        "serviceName",
        "servicePrice",
        "durationMinutes",
        "date",
        "timeSlot",
        "slotKey",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Review": {
      "title": "Review",
      "description": "Customer rating and review for a business, with optional business owner reply.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "rating": {
          "type": "number"
        },
        "comment": {
          "type": "string",
          "minLength": 3,
          "maxLength": 1000
        },
        "ownerReply": {
          "type": "string",
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "businessId", "businessName", "ownerId", "customerId", "customerName", "rating", "comment", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification sent to a customer or business owner on appointment/review updates.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "type": {
          "type": "string",
          "enum": [
            "appointment_new",
            "appointment_confirmed",
            "appointment_rejected",
            "appointment_cancelled",
            "appointment_completed",
            "review_new"
          ]
        },
        "relatedId": {
          "type": "string",
          "maxLength": 128
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "senderId", "title", "message", "type", "read", "createdAt"]
    },
    "Favourite": {
      "title": "Favourite",
      "description": "Saved business bookmark belonging to a Customer account.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "businessCategory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "businessCity": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "businessCoverUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "businessId", "businessName", "businessCategory", "businessCity", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile documents for customers and business owners."
    },
    "/businesses/{businessId}": {
      "schema": { "$ref": "#/entities/Business" },
      "description": "Public business directory listings and owner-managed details."
    },
    "/businesses/{businessId}/bookedSlots/{slotKey}": {
      "schema": { "$ref": "#/entities/BookedSlot" },
      "description": "Slot availability lock documents preventing double-booking."
    },
    "/services/{serviceId}": {
      "schema": { "$ref": "#/entities/Service" },
      "description": "Services and pricing attached to businesses."
    },
    "/appointments/{appointmentId}": {
      "schema": { "$ref": "#/entities/Appointment" },
      "description": "Customer appointments visible strictly to the customer and business owner."
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Public customer reviews and business owner replies."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Private user notifications for appointment and review events."
    },
    "/favourites/{favouriteId}": {
      "schema": { "$ref": "#/entities/Favourite" },
      "description": "Customer saved favourite businesses."
    }
  }
}
